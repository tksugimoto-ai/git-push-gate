# cp .env.example .env して、エディタで書き換える（.env はコミットされない）。空の値は既定値になる

# 必須。push を中継する GitHub のリポジトリ（PAT で接続するなら https://github.com/OWNER/REPO.git の形にし、config/ に github_token を置く）
UPSTREAM=git@github.com:OWNER/REPO.git

# 保護するブランチ（空白区切り、完全一致）。すべて GitHub にあり、デフォルトブランチを含むこと。既定 "main develop"
# develop がなければ "main" にする
PROTECTED_BRANCHES=

# この接頭辞（空白区切り。例: "agent/ claude/"）で始まるブランチしか作成・更新・削除させない。既定は制限なし
ALLOWED_BRANCH_PREFIXES=

# パスフレーズ付きの鍵を解除しておく時間（例: 8h）。既定は無期限
UNLOCK_LIFETIME=

# 1 回の push で受け付ける大きさの上限。既定 500m
MAX_PUSH_SIZE=

# ゲートのコンテナが使えるメモリの上限。既定 2g（リポジトリが大きければ増やす）
MEM_LIMIT=

# ポートを公開するアドレス。0.0.0.0 にはしないこと（LAN に公開される）
#   Docker Desktop（Mac / Windows。WSL2 バックエンドを含む）: 127.0.0.1（既定。devcontainer からは host.docker.internal）
#   Linux・WSL に直接入れた Docker Engine: docker0 の IP（多くは 172.17.0.1。devcontainer からも同じアドレス）
GATE_BIND=
# 公開するポート。既定 2222
GATE_PORT=
