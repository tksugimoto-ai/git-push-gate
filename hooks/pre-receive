#!/bin/sh
# 受け取った更新を検査し、通ったものだけを GitHub に同期 push する。
# GitHub 側で失敗したらこのフックも失敗するので、クライアントの push もエラーになる。
set -euf   # -f: 保護ブランチ名をグロブ展開しない
zero=0000000000000000000000000000000000000000
CHECK="${GIT_PUSH_GATE_CHECK:-/usr/local/share/git-push-gate/check-workflows.mjs}"   # 環境変数はテスト用
# 保護ブランチは entrypoint がリポジトリの設定に書き込む（sshd 経由では環境変数が届かないため）
PROTECTED=$(git config --get gate.protected) || PROTECTED=""
# shellcheck disable=SC2086
set -- $PROTECTED
[ $# -gt 0 ] || { echo "git-push-gate: gate.protected が設定されていないか、空です" >&2; exit 1; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
# 名前を間違えた保護ブランチは何も守らないので、GitHub にない保護ブランチがあれば受け付けない（直前に fetch 済み）
for b in $PROTECTED; do
  git rev-parse -q --verify "refs/heads/$b" >/dev/null || {
    echo "git-push-gate: 保護ブランチ $b が GitHub にありません。PROTECTED_BRANCHES を確認してください" >&2; exit 1; }
done

set --; checks=""
while read -r old new ref; do
  case "$ref" in
    refs/heads/*) ;;
    *) echo "git-push-gate: $ref は許可されていません（ブランチのみ）" >&2; exit 1 ;;
  esac
  # 空白などを含む不正な名前は、後で $checks を分割するときにずれるので先に拒否
  git check-ref-format "$ref" || { echo "git-push-gate: $ref は不正なブランチ名です" >&2; exit 1; }
  name=${ref#refs/heads/}
  # 人間やツールが取り違える名前（HEAD、refs/tags/v1 のようにタグや別の ref に見えるもの）は作らせない
  case "$name" in
    HEAD|refs/*) echo "git-push-gate: $ref は紛らわしい名前のため拒否" >&2; exit 1 ;;
  esac
  # 保護ブランチ（大文字・小文字だけが違う Main なども含む）
  for b in $PROTECTED; do
    if [ "$(lower "$name")" = "$(lower "$b")" ]; then
      echo "git-push-gate: $ref への push は禁止" >&2; exit 1
    fi
  done

  if [ "$new" = "$zero" ]; then
    spec=":$ref"                       # ブランチ削除
  else
    checks="$checks $ref $new"         # .github/actions と .github/workflows は後でまとめて検査
    spec="$new:$ref"
  fi
  # 直前に fetch した GitHub の値を lease にする（その間に誰かが push していたら失敗）。
  # クライアントが送ってきた old は信用せず、fetch した値と一致することを確かめる
  expect=$(git rev-parse -q --verify "$ref" || true)
  [ "$old" = "${expect:-$zero}" ] || { echo "git-push-gate: $ref は GitHub 側で更新されています。fetch してからやり直してください" >&2; exit 1; }
  set -- "$@" "--force-with-lease=$ref:$expect" "$spec"
done

[ $# -eq 0 ] && exit 0
# ref 名に空白は入らないので、$checks は分割して渡してよい（-f でグロブ展開もしない）
# shellcheck disable=SC2086
if [ -n "$checks" ] && ! node "$CHECK" $checks; then
  echo "git-push-gate: ポリシー違反のため拒否しました。修正するか、人間が push してください" >&2
  exit 1
fi
git push --atomic --quiet upstream "$@"
