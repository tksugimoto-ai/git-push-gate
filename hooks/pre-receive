#!/bin/sh
# 受け取った更新を検査し、通ったものだけを GitHub に同期 push する。
# GitHub 側で失敗したらこのフックも失敗するので、クライアントの push もエラーになる。
set -euf   # -f: 保護ブランチ名をグロブ展開しない
zero=0000000000000000000000000000000000000000
die() { echo "git-push-gate: $*" >&2; exit 1; }
# ブランチは名前どおりに引く（rev-parse はないと refs/tags/... などに読み替えるので使わない）
tip() { git show-ref --verify --hash "$1" 2>/dev/null || true; }
# 保護ブランチなどは entrypoint がリポジトリの設定に書き込む（sshd 経由では環境変数が届かないため）
PROTECTED=$(git config --get gate.protected) || PROTECTED=""
PREFIXES=$(git config --get gate.allowedPrefixes) || PREFIXES=""
# shellcheck disable=SC2086
set -- $PROTECTED
[ $# -gt 0 ] || die "gate.protected が設定されていないか、空です"
# 下の .github の比較は、木が正しい形（項目が並んでいて重複がない）であることを前提にしている。
# 並びの壊れた木では ls-tree に .github が見えず、比較をすり抜けるので、fsck が無効なら受け付けない
[ "$(git config --bool --get receive.fsckObjects || true)" = true ] || die "receive.fsckObjects が有効ではありません"
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
hex40() { printf '%s' "$1" | grep -Eqx '[0-9a-f]{40}'; }
# 名前を間違えた保護ブランチは何も守らないので、GitHub にない保護ブランチがあれば受け付けない（直前に fetch 済み）
for b in $PROTECTED; do
  [ -n "$(tip "refs/heads/$b")" ] || die "保護ブランチ $b が GitHub にありません。PROTECTED_BRANCHES を確認してください"
done
# デフォルトブランチ（master や trunk のこともある）が保護されていなければ受け付けない
default=$(timeout 60 git ls-remote --symref upstream HEAD | awk '$1 == "ref:" && $3 == "HEAD" { sub("^refs/heads/", "", $2); print $2 }')
[ -n "$default" ] || die "GitHub のデフォルトブランチを確かめられません"
case " $PROTECTED " in
  *" $default "*) ;;
  *) die "デフォルトブランチ ${default:-（不明）} が PROTECTED_BRANCHES に入っていません" ;;
esac
default_tip=$(tip "refs/heads/$default")

# ワークフローと複合アクションは、エージェントには変更させない（人間が push する）。
# 中身は解析しない。解析すると、GitHub のパーサーとの解釈の違いや、PR のマージコミットで組み合わされた
# 内容（検査されない）を突かれるため。許すのは、次の「基準」に収まる内容だけ:
#   - 保護ブランチのどれか 1 つ（複数の保護ブランチの版を混ぜることはさせない）
#   - push 先のブランチで、人間が変更したもの（デフォルトブランチとの分岐点の版と違うもの）。
#     人間が push したワークフローの上に、エージェントがコミットを積めるように。分岐点と同じもの
#     （main から写しただけの古い版）は含めないので、人間が main のワークフローを直した後に、
#     既存のブランチで古い版を動かし続けることはできない
WF=.github/workflows
# git の失敗を「項目なし」と取り違えないよう、どれも失敗したら拒否する（tree_ok などは if や || の中で
# 呼ばれ、set -e が効かないため、明示的に確かめる）
entry() { git ls-tree "$1" -- "$2" || die "$1 の $2 を読めません"; }   # パスの項目（mode type oid と、引用符付きのパス）。なければ空
tree_ok() { # ディレクトリでないもの（シンボリックリンクなど）だと中身を列挙できず、比較をすり抜けるので拒否
  for p in .github "$WF"; do
    e=$(entry "$1" "$p") || exit 1
    [ -z "$e" ] || [ "${e#040000 tree }" != "$e" ] || return 1
  done
}
workflows() { git ls-tree -r "$1" -- "$WF/" || die "$1 のワークフローを読めません"; }   # パスは常に同じ規則で引用されるので、行どうしで比べてよい
case_ok() { # 大文字・小文字だけが違う .GITHUB や .github/Workflows は、取り違えのもとなので拒否
  r=$(git ls-tree --name-only "$1") || die "$1 を読めません"
  [ "$(printf '%s\n' "$r" | grep -ix '\.github' || true)" = "$(printf '%s\n' "$r" | grep -x '\.github' || true)" ] || return 1
  d=$(git ls-tree --name-only "$1" -- .github/) || die "$1 の .github を読めません"
  [ "$(printf '%s\n' "$d" | grep -iEx '\.github/(workflows|actions)' || true)" = \
    "$(printf '%s\n' "$d" | grep -Ex '\.github/(workflows|actions)' || true)" ]
}
subset() { # subset 行の一覧 許す行の一覧: 前者のすべての行が後者にあれば真
  printf '%s\n' "$1" | grep . | while IFS= read -r line; do
    printf '%s\n' "$2" | grep -Fqx -- "$line" || exit 1
  done
}
check_commit() { # check_commit ref new 今の値（なければ空）
  tree_ok "$2" || die "$1: .github か .github/workflows がディレクトリではありません"
  case_ok "$2" || die "$1: 大文字・小文字だけが違う .github / workflows / actions は使えません"
  files=$(workflows "$2"); actions=$(entry "$2" .github/actions)
  # push 先のブランチで人間が変更したもの
  human=""; human_actions=no
  if [ -n "$3" ] && tree_ok "$3"; then
    mb=$(git merge-base "$3" "$default_tip" || true)   # 共通の祖先がなければ、人間の変更はないものとする
    if [ -n "$mb" ]; then
      tree_ok "$mb" && fork=$(workflows "$mb") || fork=""
      human=$(workflows "$3" | while IFS= read -r line; do
        printf '%s\n' "$fork" | grep -Fqx -- "$line" || printf '%s\n' "$line"
      done)
      [ "$(entry "$3" .github/actions)" = "$(entry "$mb" .github/actions)" ] || human_actions=yes
    fi
  fi
  [ "$human_actions" = yes ] && cur_actions=$(entry "$3" .github/actions) || cur_actions=""
  for b in $PROTECTED; do
    c=$(tip "refs/heads/$b"); tree_ok "$c" || continue
    base_actions=$(entry "$c" .github/actions)
    if [ "$actions" = "$base_actions" ] || { [ "$human_actions" = yes ] && [ "$actions" = "$cur_actions" ]; }; then
      allowed=$(workflows "$c"; printf '%s\n' "$human")
      if subset "$files" "$allowed"; then return 0; fi
    fi
  done
  die "$1: .github/workflows か .github/actions を変更しているため拒否（保護ブランチの 1 つに、このブランチで人間が変更したものを加えた内容と一致しない）。人間が push するか、main に rebase してください"
}

set --; log=""
while read -r old new ref; do
  # receive-pack は ref 名を検査する前にフックへ渡すので、行の形式から確かめる（改行を埋め込んだ ref 名など）
  hex40 "$old" && hex40 "$new" || die "不正な更新の指定です"
  case "$ref" in
    refs/heads/*) ;;
    *) die "$ref は許可されていません（ブランチのみ）" ;;
  esac
  git check-ref-format "$ref" || die "$ref は不正なブランチ名です"
  name=${ref#refs/heads/}
  # 人間やツールが取り違える名前（HEAD、refs/tags/v1 のようにタグや別の ref に見えるもの）は作らせない。
  # 40 桁の 16 進数の名前は、push の指定でコミット ID と取り違えられる（検査したものと別のものが push される）
  if [ "$name" = HEAD ] || [ "${name#refs/}" != "$name" ] || hex40 "$name"; then
    die "$ref は紛らわしい名前のため拒否"
  fi
  # 保護ブランチ（大文字・小文字だけが違う Main なども含む）
  for b in $PROTECTED; do
    [ "$(lower "$name")" != "$(lower "$b")" ] || die "$ref への push は禁止"
  done
  # 許可する接頭辞（ALLOWED_BRANCH_PREFIXES）が設定されていれば、それ以外のブランチは作成・更新・削除させない
  if [ -n "$PREFIXES" ]; then
    okp=no
    for p in $PREFIXES; do [ "${name#"$p"}" = "$name" ] || okp=yes; done
    [ "$okp" = yes ] || die "$ref は許可された接頭辞（$PREFIXES）で始まっていません"
  fi

  # 直前に fetch した GitHub の値を lease にする（その間に誰かが push していたら失敗）。
  # クライアントが送ってきた old は信用せず、fetch した値と一致することを確かめる
  expect=$(tip "$ref")
  [ "$old" = "${expect:-$zero}" ] || die "$ref は GitHub 側で更新されています。fetch してからやり直してください"
  if [ "$new" = "$zero" ]; then
    spec=":$ref"                       # ブランチ削除
  else
    check_commit "$ref" "$new" "$expect"
    spec="$new:$ref"
  fi
  set -- "$@" "--force-with-lease=$ref:$expect" "$spec"
  log="$log$(date -u +%Y-%m-%dT%H:%M:%SZ) $ref $old $new
"
done

[ $# -eq 0 ] && exit 0
timeout 300 git push --atomic --quiet upstream "$@"
# 受け付けた更新の記録（人間が後で確かめられるように）。GitHub への push が成功したものだけ
# （書き込みに失敗しても、GitHub には push 済みなので、クライアントには成功を返す）
printf '%s' "$log" >> "$(git rev-parse --git-dir)/push-gate.log" || echo "git-push-gate: 警告: 記録を書き込めませんでした" >&2
